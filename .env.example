APP_NAME=CARWASH
APP_ENV=production
APP_KEY=                        # Generar con: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tu-app.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de datos PostgreSQL ---
# Railway inyecta estas variables automáticamente si conectas el plugin de PostgreSQL.
# También puedes copiarlas desde Railway Dashboard > PostgreSQL > Variables
DB_CONNECTION=pgsql
DB_HOST=                        # Desde Railway: PGHOST
DB_PORT=5432                    # Desde Railway: PGPORT
DB_DATABASE=                    # Desde Railway: PGDATABASE
DB_USERNAME=                    # Desde Railway: PGUSER
DB_PASSWORD=                    # Desde Railway: PGPASSWORD

# --- JWT ---
JWT_SECRET=                     # Generar con: php artisan jwt:secret --show

# --- Vite / Frontend ---
VITE_API_URL=/api/

# --- Cache / Session ---
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
